# ───────── Google Sheets (leitura somente no servidor) ─────────
# ID da planilha: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
# (opcional) planilha de vendas "Ramon Souza - Vendas Gerais"; já vem preenchida por padrão no código
SALES_SHEET_ID=
# E-mail da Service Account (campo "client_email" do JSON da chave)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chave privada ("private_key" do JSON) entre aspas, com \n literais, em UMA linha:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# ───────── Opcionais ─────────
# Início da captação (AAAA-MM-DD). Se vazio, usa a menor data encontrada nas abas.
CAMPAIGN_START=
# true = usa dados fictícios (pré-visualização sem credenciais)
DEMO_MODE=false
